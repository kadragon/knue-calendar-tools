{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "knue-event-harvester",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": [] },
  "durable_objects": {
    "bindings": [{ "name": "HARVEST_STATE", "class_name": "HarvestState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HarvestState"] }],
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "knue-event-harvester-staging",
      "workers_dev": true,
      "preview_urls": false,
      "triggers": { "crons": [] },
      "durable_objects": {
        "bindings": [{ "name": "HARVEST_STATE", "class_name": "HarvestState" }]
      }
    }
  }
}
