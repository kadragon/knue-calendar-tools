{
  "name": "knue-event-harvester",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist --env \"\"",
    "dev": "wrangler dev",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:coverage:ui": "vitest --run --coverage --reporter=html",
    "lint": "npm run typecheck",
    "typecheck": "npm run types --silent && tsc --noEmit",
    "deploy": "wrangler deploy",
    "types": "wrangler types --env-interface WorkerBindings",
    "build:staging": "wrangler deploy --dry-run --env staging"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "0.28.2",
    "miniflare": "5.20261119.0-beta",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.0.16",
    "wrangler": "^4.160.0"
  }
}
